
name: Feature Request
description: Suggest a feature or improvement for ReCam.
title: "[Feature]: "
labels:
  - enhancement
body:
  - type: markdown
    attributes:
      value: |
        Explain the problem you want to solve and how your proposed feature
        would improve ReCam. Please check existing issues first.

  - type: textarea
    id: problem
    attributes:
      label: Problem or Motivation
      description: What limitation or use case does this address?
      placeholder: "As a user, I want to..."
    validations:
      required: true

  - type: textarea
    id: solution
    attributes:
      label: Proposed Solution
      description: Describe how you would like the feature to work.
    validations:
      required: true

  - type: dropdown
    id: platform
    attributes:
      label: Relevant Platform
      multiple: true
      options:
        - iOS / iPhone
        - Windows
        - Linux
        - Discord
        - All platforms
        - Other
    validations:
      required: true

  - type: dropdown
    id: priority
    attributes:
      label: Importance
      options:
        - Nice to have
        - Would significantly improve my workflow
        - Blocking my use of ReCam
    validations:
      required: true

  - type: textarea
    id: alternatives
    attributes:
      label: Alternatives and Additional Context
      description: Describe any workarounds, alternatives, or relevant examples.
    validations:
      required: false
